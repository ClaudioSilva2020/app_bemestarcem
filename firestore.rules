rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: leitura pública, escrita apenas pelo painel administrativo
    // (via console/Admin SDK, que ignora estas regras).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Cada usuário só enxerga e altera o próprio cadastro e o próprio carrinho.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /cart/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
